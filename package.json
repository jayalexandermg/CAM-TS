{
  "name": "infinite-aura-ts",
  "version": "0.1.0",
  "description": "Self-healing, self-improving memory system for AI agents",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "cam": "./dist/cli/main.js"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "build:cli": "tsc && chmod +x dist/cli/main.js",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "check:all": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "audit": "pnpm audit --audit-level=moderate",
    "precommit": "lint-staged",
    "dev": "ts-node src/cli/main.ts"
  },
  "devDependencies": {
    "@types/handlebars": "^4.1.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "keywords": [
    "ai",
    "memory",
    "agents",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "handlebars": "^4.7.8",
    "yaml": "^2.8.2"
  }
}
